{
  "name": "studyswap-functions",
  "description": "Server-side logic for StudySwap: reputation, deal completion and moderation.",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:emulate": "firebase emulators:exec --only firestore --project studyswap-functions-test \"npm test\"",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
