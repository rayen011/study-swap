rules_version = '2';

// StudySwap Cloud Storage rules.
//
// Deploy with:  firebase deploy --only storage
//
// The owner's uid is part of the path, so ownership is checked without a
// Firestore lookup — Storage rules can't read Firestore, and baking the uid
// into the path is the standard way around that.
//
// Path shape: listings/{userId}/{listingId}/{fileName}

service firebase.storage {
  match /b/{bucket}/o {

    match /listings/{userId}/{listingId}/{fileName} {
      // Any signed-in member can view listing photos.
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Owners clean up their own images when a listing is deleted.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Nothing else is writable, and nothing else is readable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
